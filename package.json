{
  "name": "langchain-rag",
  "version": "1.0.0",
  "description": "Production-grade RAG agent built on LangChain Deep Agents: hybrid retrieval (Dense + BM25), query rewrite, cross-encoder rerank, and a built-in offline evaluation toolkit.",
  "private": true,
  "type": "module",
  "scripts": {
    "rag": "pnpm --filter @langchain-rag/rag run start",
    "rag:index": "pnpm --filter @langchain-rag/rag run index",
    "serve": "pnpm --filter @langchain-rag/api run serve",
    "dev": "pnpm --filter @langchain-rag/web run dev",
    "dev:all": "concurrently -n api,web -c blue,green \"pnpm serve\" \"pnpm dev\"",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advancedcat/langchain-rag.git"
  },
  "keywords": [
    "langchain",
    "deepagents",
    "langgraph",
    "rag",
    "hybrid-search",
    "bm25",
    "vector-search",
    "qdrant",
    "retrieval-augmented-generation",
    "llm",
    "ai-agent",
    "evaluation"
  ],
  "author": "advancedcat",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/advancedcat/langchain-rag/issues"
  },
  "homepage": "https://github.com/advancedcat/langchain-rag#readme",
  "packageManager": "pnpm@10.7.0",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
