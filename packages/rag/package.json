{
  "name": "docs-rag-agent",
  "version": "1.0.0",
  "description": "Deep Agents RAG documentation Q&A agent (indexes LangChain docs, offloads chunks, delegates analysis to subagents)",
  "main": "src/agent.ts",
  "scripts": {
    "start": "tsx src/agent.ts",
    "index": "tsx src/agent.ts --index-only",
    "eval": "tsx evals/retrieval/run.ts",
    "eval:rebuild": "tsx evals/retrieval/run.ts --rebuild",
    "eval:json": "tsx evals/retrieval/run.ts --json",
    "eval:gen": "tsx evals/generation/run.ts",
    "eval:gen:json": "tsx evals/generation/run.ts --json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "langchain",
    "deepagents",
    "rag"
  ],
  "author": "advancedcat",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@langchain/classic": "^1.0.41",
    "@langchain/core": "^1.2.5",
    "@langchain/openai": "^1.5.6",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "deepagents": "^1.12.2",
    "dotenv": "^17.4.2",
    "langchain": "^1.5.5",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
