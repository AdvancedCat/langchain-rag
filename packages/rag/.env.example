# ============================================================================
# Chat model (LLM) — DeepSeek (OpenAI-compatible API)
# ============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key
# Default model: deepseek-v4-flash (supports tool calling)
# LLM_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional generation parameters
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# ============================================================================
# Embedding model — Qianwen / DashScope
# ============================================================================
# Get API key from https://platform.qianwenai.com/home/api-keys
DASHSCOPE_API_KEY=your_qianwen_api_key
# For qianwenai.com use: https://dashscope.aliyuncs.com/compatible-mode/v1
# For Aliyun Model Studio use: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Supported models: qwen3.7-text-embedding, text-embedding-v4, text-embedding-v3
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
# Optional: custom vector dimension, supported range 256~2560
# QWEN_EMBEDDING_DIMENSIONS=1536

# ============================================================================
# Vector Store (Qdrant)
# ============================================================================
# Start Qdrant locally first: docker compose up -d (or make infra-up)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_api_key_for_production
QDRANT_COLLECTION=langchain_docs

# ============================================================================
# Retrieval strategy
# ============================================================================
RETRIEVAL_TOP_K=4
RETRIEVAL_FETCH_K=20
# Optional cosine-similarity noise filter. Calibrate before enabling.
# RETRIEVAL_SCORE_THRESHOLD=0.55
# MMR is opt-in for the online agent; evaluation can enable it via --strategy.
RETRIEVAL_MMR_ENABLED=false
RETRIEVAL_MMR_LAMBDA=0.9

# Hybrid retrieval (dense vector + BM25 sparse, score-level boost fusion)
# Dense is the primary signal; BM25 provides a lightweight keyword boost.
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_RRF_CONSTANT=60
RETRIEVAL_SPARSE_TOP_K=5
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_DENSE_WEIGHT=2
RETRIEVAL_SPARSE_WEIGHT=0.5

# Query transformation
RETRIEVAL_QUERY_REWRITE=true
RETRIEVAL_MULTI_QUERY=false
RETRIEVAL_MULTI_QUERY_COUNT=3

# ============================================================================
# Observability (optional)
# ============================================================================
# Uncomment and set a real LANGSMITH_API_KEY to enable LangSmith tracing.
# Leaving TRACING=true with the placeholder key causes 403 errors on every LLM call.
LANGSMITH_TRACING=false
