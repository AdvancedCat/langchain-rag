# ============================================================================
# API Server（@langchain-rag/api）
# ============================================================================
# LLM / Embedding / Qdrant / Retrieval 配置不在此重复维护：
# 服务启动时先加载本文件，再以不覆盖方式加载 ../rag/.env 补齐（src/env.ts）。
# ============================================================================

PORT=3000
HOST=0.0.0.0
# 事件日志/会话元数据/LangGraph checkpoint（docker compose 已含 redis 服务）
REDIS_URL=redis://localhost:6379

# 逗号分隔的前端来源白名单；* 关闭校验（仅开发环境）
RAG_API_CORS_ORIGINS=http://localhost:5173

# 进程级 run 并发闸门（DashScope TPM 限流防护，方案 §8.4）
RAG_MAX_CONCURRENT_RUNS=4
# 单个 run 的执行上限（毫秒），到点强制取消并发出 RUN_ERROR{code:"timeout"}
RAG_RUN_TIMEOUT_MS=300000
# 会话事件日志与元数据保留期（小时）
THREAD_TTL_HOURS=720
# SSE 注释心跳间隔（毫秒）
SSE_HEARTBEAT_MS=15000
# retrieval.trace CUSTOM 事件开关（方案 §6）
RETRIEVAL_TRACE_EVENTS=true
